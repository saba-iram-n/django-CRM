# Django secret key used for signing sessions and CSRF tokens. Generate a long random string;
# never commit the real value. Required in production.
SECRET_KEY=

# Set to true, 1, yes, or on to enable Django DEBUG (only read from this file, not from shell env).
# Omit or leave empty for False (recommended for production).
DEBUG=

# Comma-separated hostnames this site may serve (no spaces around commas). Example:
# localhost,127.0.0.1,myapp.onrender.com
ALLOWED_HOSTS=

# PostgreSQL database name. Leave all DB_* empty to use SQLite locally.
DB_NAME=

# PostgreSQL user.
DB_USER=

# PostgreSQL password.
DB_PASSWORD=

# PostgreSQL host (e.g. your Render Postgres internal hostname).
DB_HOST=
